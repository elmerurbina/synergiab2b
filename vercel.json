{
    "version": 2,
    "builds": [
        {
            "src": "package.json",
            "use": "@vercel/static-build",
            "config": {
                "distDir": "build",
                "buildCommand": "CI=false DISABLE_ESLINT_PLUGIN=true npm run build"
            }
        },
        {
            "src": "backend/manage.py",
            "use": "@vercel/python",
            "config": {
                "maxLambdaSize": "15mb"
            }
        }
    ],
    "routes": [
        {
            "src": "/api/(.*)",
            "dest": "/backend/manage.py"
        },
        {
            "src": "/(.*)",
            "dest": "/$1"
        }
    ]
}